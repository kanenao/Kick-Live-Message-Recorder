{
  "name": "kick-live-message-recorder",
  "version": "0.1.0-beta.12",
  "private": true,
  "description": "Kick配信の映像・音声・チャットを保存するWindowsアプリ",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env KICK_RECORDER_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "publish:win": "npm run build && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "electron-updater": "^6.8.12"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "jp.kanenao.kickrecorder",
    "productName": "Kick Live Message Recorder",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kick Live Message Recorder",
      "language": 1041,
      "installerLanguages": [
        "ja_JP"
      ],
      "displayLanguageSelector": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kanenao",
        "repo": "Kick-Live-Message-Recorder",
        "releaseType": "prerelease"
      }
    ],
    "extraResources": [
      {
        "from": "vendor/win-x64/yt-dlp.exe",
        "to": "tools/yt-dlp.exe"
      },
      {
        "from": "vendor/win-x64/cloudflared.exe",
        "to": "tools/cloudflared.exe"
      }
    ]
  },
  "author": "kanenao",
  "repository": {
    "type": "git",
    "url": "https://github.com/kanenao/Kick-Live-Message-Recorder.git"
  },
  "productName": "Kick Live Message Recorder"
}
