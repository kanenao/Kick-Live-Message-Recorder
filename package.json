{
  "name": "kick-live-message-recorder",
  "version": "1.5.0-beta.115",
  "private": true,
  "description": "Kick配信の映像・音声・チャットを保存するWindowsアプリ",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env KICK_RECORDER_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "build": "npm run build:icons && npm run typecheck && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "publish:win": "npm run build && electron-builder --win nsis --publish always",
    "build:icons": "node scripts/generate-app-icon.mjs",
    "predev": "npm run build:icons"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "electron-updater": "^6.8.12",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.4",
    "@types/ws": "^8.18.2"
  },
  "build": {
    "appId": "jp.kanenao.kickrecorder",
    "productName": "Kick Live Message Recorder",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Kick-Live-Message-Recorder-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kick Live Message Recorder",
      "language": 1041,
      "installerLanguages": [
        "ja_JP"
      ],
      "displayLanguageSelector": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kanenao",
        "repo": "Kick-Live-Message-Recorder",
        "releaseType": "prerelease",
        "channel": "beta"
      }
    ],
    "extraResources": [
      {
        "from": "vendor/win-x64/yt-dlp.exe",
        "to": "tools/yt-dlp.exe"
      },
      {
        "from": "vendor/win-x64/ffmpeg.exe",
        "to": "tools/ffmpeg.exe"
      },
      {
        "from": "vendor/win-x64/ffprobe.exe",
        "to": "tools/ffprobe.exe"
      },
      {
        "from": "vendor/win-x64/FFmpeg-LGPL-2.1.txt",
        "to": "tools/FFmpeg-LGPL-2.1.txt"
      },
      {
        "from": "vendor/win-x64/FFmpeg-NOTICE.txt",
        "to": "tools/FFmpeg-NOTICE.txt"
      },
      {
        "from": "build/icon.png",
        "to": "branding/icon.png"
      }
    ]
  },
  "author": "kanenao",
  "repository": {
    "type": "git",
    "url": "https://github.com/kanenao/Kick-Live-Message-Recorder.git"
  },
  "productName": "Kick Live Message Recorder"
}
